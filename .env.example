PORT=4000
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
DB_PATH=./progress.db

# Analytics export (/api/analytics/*). Reads across all teachers and classes,
# so the routes are unreachable until this is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Salt for the hashed student/teacher/class IDs in the analytics export.
# Keep it stable so IDs match between exports; falls back to JWT_SECRET.
ANALYTICS_SALT=

# Deploy date (YYYY-MM-DD) of the engagement-threshold tracker. Completions
# recorded before this were fired on page load and mean "opened", not
# "completed". Setting it lets the funnel report the two separately.
COMPLETION_FIX_DATE=

# How long raw event rows are kept before being rolled into daily totals and
# deleted. Daily totals are kept forever. Default 180.
EVENT_RETENTION_DAYS=180

# Rate limits for the public event ingest endpoint, per minute.
# Defaults: 120 per IP, 60 per session.
EVENT_RATE_LIMIT_IP=
EVENT_RATE_LIMIT_SESSION=
